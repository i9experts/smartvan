# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/smartvan?retryWrites=true&w=majority
JWT_SECRET=
PORT=3002
DEFAULT_TIMEZONE=Asia/Karachi

# Google Distance Matrix (ETA) — server key, restricted by IP
GOOGLE_MAPS_API_KEY=

# Firebase Admin (base64 of the service-account JSON)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
SMTP_PASSWORD=

# Payments / messaging
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

FRONTEND_URL=
GOOGLE_CLIENT_ID=

# Phase 2 — pre-trip checklist
REQUIRE_PRETRIP_CHECKLIST=false
# Optional JSON override: [{"key":"tyres","label":"Tyres OK"}]
PRETRIP_CHECKLIST_ITEMS=
